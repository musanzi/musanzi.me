---
import Icon from '../shared/Icon.astro'
import { formatArticleDate } from '../../lib/articles'
import { courseUrl, formatChapterCount, formatMinutes, type Course } from '../../lib/courses'

interface Props {
  course: Course
  chapterCount: number
  totalMinutes: number
}

const { course, chapterCount, totalMinutes } = Astro.props
---

<li class="border-b border-neutral-800">
  <a class="group flex items-start gap-6 py-8 md:gap-10" href={courseUrl(course.id)}>
    <div class="min-w-0 flex-1">
      <h2
        class="text-2xl leading-tight font-semibold tracking-[-0.02em] text-balance break-words text-neutral-50 transition-colors group-hover:text-primary-300">
        {course.data.title}
      </h2>
      <p class="mt-3 max-w-2xl leading-relaxed text-pretty text-neutral-400">{course.data.description}</p>
      <p class="mt-4 flex flex-wrap items-center gap-x-2 gap-y-1 font-code text-sm text-neutral-400">
        <span>{formatChapterCount(chapterCount)}</span>
        <span aria-hidden="true">·</span>
        <span>{formatMinutes(totalMinutes)}</span>
        <span aria-hidden="true">·</span>
        <time datetime={course.data.publishedAt.toISOString()}>{formatArticleDate(course.data.publishedAt)}</time>
      </p>
    </div>
    <Icon
      class="mt-1.5 size-6 shrink-0 text-neutral-500 transition duration-200 group-hover:translate-x-1 group-hover:text-primary-300"
      name="arrow-right" />
  </a>
</li>
