---
import Thumbnail from '../shared/Thumbnail.astro'
import { formatArticleDate } from '../../lib/articles'
import { courseUrl, formatChapterCount, formatMinutes, type Course } from '../../lib/courses'

interface Props {
  course: Course
  chapterCount: number
  totalMinutes: number
  headingLevel?: 2 | 3
}

const { course, chapterCount, totalMinutes, headingLevel = 2 } = Astro.props
const Heading = headingLevel === 2 ? 'h2' : 'h3'
---

<li class="border-b border-neutral-800">
  <a
    class="group grid gap-4 py-6 sm:grid-cols-[13rem_1fr] sm:items-center sm:gap-6 md:grid-cols-[16rem_1fr] md:gap-8"
    href={courseUrl(course.id)}>
    <Thumbnail
      class="transition-colors duration-200 group-hover:border-neutral-600"
      title={course.data.cover?.title ?? course.data.title}
      subtitle={course.data.cover?.subtitle}
      sizes="(min-width: 40rem) 8rem, 46vw" />
    <div class="min-w-0">
      <p class="flex flex-wrap items-center gap-x-2 gap-y-1 font-code text-sm text-neutral-500">
        <span>{formatChapterCount(chapterCount)}</span>
        <span class="size-1 rounded-full bg-neutral-600" aria-hidden="true"></span>
        <span>{formatMinutes(totalMinutes)}</span>
        <span class="size-1 rounded-full bg-neutral-600" aria-hidden="true"></span>
        <time datetime={course.data.publishedAt.toISOString()}>{formatArticleDate(course.data.publishedAt)}</time>
      </p>
      <Heading
        class="mt-2 text-xl leading-snug font-semibold text-balance break-words text-neutral-50 transition-colors group-hover:text-primary-300 md:text-2xl">
        {course.data.title}
      </Heading>
      <p class="mt-2 max-w-[65ch] leading-relaxed text-pretty text-neutral-400">{course.data.description}</p>
    </div>
  </a>
</li>
