---
import { chapterUrl, formatChapterNumber, type Chapter } from '../../lib/courses'

interface Props {
  chapters: Chapter[]
  currentId: string
}

const { chapters, currentId } = Astro.props
---

<ol class="space-y-0.5">
  {
    chapters.map((chapter, index) => (
      <li>
        <a
          class="-ml-px flex min-h-10 items-baseline gap-3 border-l border-neutral-800 py-2 pr-2 pl-4 text-sm leading-snug text-neutral-400 transition-colors hover:border-neutral-500 hover:text-neutral-100 aria-[current=page]:border-primary-500 aria-[current=page]:bg-neutral-800/40 aria-[current=page]:text-neutral-50"
          href={chapterUrl(chapter)}
          aria-current={chapter.id === currentId ? 'page' : undefined}>
          <span class="font-code text-xs text-neutral-500">{formatChapterNumber(index + 1)}</span>
          <span class="min-w-0 break-words">{chapter.data.title}</span>
        </a>
      </li>
    ))
  }
</ol>
