---
import Icon from '../shared/icon.astro'
import ProjectCard from '../projects/project-card.astro'
import { projects } from '../../data/projects'

const featuredProjects = projects.slice(0, 2)
---

<section id="projects" class="mb-14 scroll-mt-8 md:mb-22" aria-labelledby="projects-title">
  <div class="mb-3 flex items-center gap-2.5">
    <p
      class="inline-flex items-center gap-1.5 text-sm leading-4 font-semibold tracking-wide whitespace-nowrap text-neutral-400">
      <Icon class="size-4" name="folder-code" />
      Proven work
    </p>
    <div class="h-px w-full bg-neutral-700"></div>
  </div>

  <div class="mb-7 flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
    <h2 id="projects-title" class="text-2xl leading-tight font-bold text-neutral-50">
      Products built around real needs and projects.
    </h2>
    <a class="inline-flex shrink-0 items-center gap-1.5 text-sm font-semibold text-primary-400 transition hover:text-primary-300 focus-visible:rounded-sm focus-visible:ring-2 focus-visible:ring-primary-400 focus-visible:outline-none" href="/projects">
      View all projects
      <Icon class="size-3.5" name="arrow-right" />
    </a>
  </div>

  <div class="grid gap-4 md:grid-cols-2">
    {featuredProjects.map((project) => <ProjectCard project={project} />)}
  </div>
</section>
