---
import Logo from '../../assets/wilfried.jpeg'
import Icon from '../shared/icon.astro'
---

<section class="mb-18 pt-10 text-neutral-300 md:mb-28" aria-labelledby="hero-title">
  <div class="flex flex-col md:flex-row md:items-center gap-2 md:gap-4">
    <div class="mb-5 size-21 overflow-hidden rounded-full border-2 border-primary-400 bg-neutral-900 shadow-[0_0_0_4px] shadow-primary-600/15">
      <img
        class="size-full object-cover object-[50%_17%]"
        src={Logo.src}
        width="853"
        height="1280"
        fetchpriority="high"
        alt="Wilfried Musanzi" />
    </div>
    <p class="mb-2 text-lg font-medium text-neutral-400">Hi, I'm Wilfried Musanzi</p>
  </div>
  <h1 id="hero-title" class="max-w-[20ch] text-3xl leading-none font-bold tracking-normal text-neutral-200">
    Fullstack Web Developer
  </h1>
  <p class="mt-6 max-w-4xl text-neutral-400">
    I build reliable web applications that help businesses simplify operations, improve productivity, and manage their
    work more efficiently. 3+ years turning real business workflows into software teams actually use.
  </p>
  <div class="mt-6 flex flex-wrap items-center gap-3">
    <a
      class="group inline-flex min-h-11 items-center justify-center gap-2 rounded-lg bg-primary-600 px-4 py-2 text-base font-semibold text-surface shadow-primary-600/20 transition-all duration-200 hover:bg-primary-700 active:translate-y-0 active:scale-[0.98] focus-visible:ring-2 focus-visible:ring-primary-300 focus-visible:ring-offset-2 focus-visible:ring-offset-surface focus-visible:outline-none"
      href="https://github.com/musanzi"
      target="_blank"
      rel="noreferrer"
      aria-label="View Wilfried Musanzi on GitHub">
      GitHub
      <Icon class="size-4 transition-transform duration-200 group-hover:rotate-6 group-hover:scale-110" name="github" />
    </a>
    <a
      class="group inline-flex min-h-11 items-center justify-center gap-2 rounded-lg border border-neutral-700 bg-neutral-900 px-4 py-2 text-base font-medium text-neutral-300 transition-all duration-200 hover:border-primary-600 hover:bg-neutral-800 hover:text-neutral-50 hover:shadow-[0_10px_24px] hover:shadow-black/20 active:translate-y-0 active:scale-[0.98] focus-visible:ring-2 focus-visible:ring-primary-400 focus-visible:ring-offset-2 focus-visible:ring-offset-surface focus-visible:outline-none"
      href="/blog">
      Read the blog
      <Icon class="size-4 transition-transform duration-200 group-hover:-translate-y-0.5 group-hover:translate-x-0.5" name="arrow-up-right" />
    </a>
  </div>
</section>
