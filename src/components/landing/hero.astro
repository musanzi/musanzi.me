---
import Logo from '../../assets/wilfried.jpeg'
import Icon from '../shared/icon.astro'
---

<section class="mb-18 pt-10 text-neutral-300 md:mb-28" aria-labelledby="hero-title">
  <div class="flex flex-col gap-2 md:flex-row md:items-center md:gap-4">
    <div class="mb-5 size-21 overflow-hidden rounded-full border-2 border-primary-400 bg-neutral-900 shadow-[0_0_0_4px] shadow-primary-600/15">
      <img
        class="size-full object-cover object-[50%_17%]"
        src={Logo.src}
        width="853"
        height="1280"
        fetchpriority="high"
        alt="Wilfried Musanzi" />
    </div>
    <div class="mb-2">
      <p class="text-lg font-medium text-neutral-300">Hi, I'm Wilfried Musanzi</p>
      <p class="mt-1 text-sm text-neutral-500">
        Lead Software Developer at 
        <span> <a
          class="transition text-primary-400 hover:underline focus-visible:rounded-sm focus-visible:ring-2 focus-visible:ring-primary-400 focus-visible:outline-none"
          href="https://www.linkedin.com/company/cinolu"
          target="_blank"
          rel="noreferrer">
          @Cinolu
          </a>
        </span>
      </p>
    </div>
  </div>
  <h1 id="hero-title" class="max-w-[20ch] text-2xl md:text-3xl leading-none font-bold tracking-normal text-neutral-200">
    I turn operational needs into reliable web products.
  </h1>
  <p class="mt-6 max-w-4xl text-neutral-400">
    I help teams and organizations move from an unclear workflow to a deployed, maintainable application combining
    product thinking, Angular and NestJS development, and hands-on production operations.
  </p>
  <p class="mt-3 text-sm font-medium text-neutral-500">
    Professional communication in English and French · Open to full-time roles, fixed-term contracts, and freelance
    projects.
  </p>
  <div class="mt-6 flex flex-wrap items-center gap-3">
    <a
      class="group inline-flex min-h-11 items-center justify-center gap-2 text-sm rounded-lg bg-primary-600 px-4 py-1 font-semibold text-white shadow-primary-600/20 transition-all duration-200 hover:bg-primary-700 active:translate-y-0 active:scale-[0.98] focus-visible:ring-2 focus-visible:ring-primary-300 focus-visible:ring-offset-2 focus-visible:ring-offset-white focus-visible:outline-none"
      href="#projects">
      My work
      <Icon class="size-4 transition-transform duration-200 group-hover:translate-x-1" name="arrow-right" />
    </a>
    <a
      class="group inline-flex min-h-11 items-center justify-center gap-2 rounded-lg border border-neutral-700 bg-neutral-900 px-4 py-1 text-sm font-medium text-neutral-300 transition-all duration-200 hover:border-primary-600 hover:bg-neutral-800 hover:text-neutral-50 hover:shadow-[0_10px_24px] hover:shadow-black/20 active:translate-y-0 active:scale-[0.98] focus-visible:ring-2 focus-visible:ring-primary-400 focus-visible:ring-offset-2 focus-visible:ring-offset-surface focus-visible:outline-none"
      href="#contact">
      Let's connect
      <Icon class="size-4 transition-transform duration-200 group-hover:-translate-y-0.5 group-hover:translate-x-0.5" name="arrow-up-right" />
    </a>
  </div>
</section>
