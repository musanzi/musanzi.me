---
import { Image } from 'astro:assets'
import portrait from '../../assets/wilfried.jpeg'
import Icon from '../shared/Icon.astro'

const stats = [
  { value: '3+ ans', label: "d'expérience" },
  { value: '10 000+', label: "comptes sur les plateformes que j'ai livrées" },
  { value: '13', label: 'apprenants formés' }
]
---

<section class="relative overflow-hidden border-b border-neutral-800" aria-labelledby="hero-title">
  <div class="page-shell relative z-10 flex flex-col justify-center pt-14 pb-12 md:pt-20 md:pb-16 lg:min-h-[min(calc(100svh-4rem),56rem)] lg:py-20">
    <div class="lg:w-1/2 lg:pr-10">
      <p class="flex flex-wrap items-center gap-x-3 gap-y-1 font-code text-xs tracking-[0.18em] text-neutral-400 uppercase sm:text-sm">
        <span>Développeur fullstack</span>
        <span class="size-1 rounded-full bg-primary-600" aria-hidden="true"></span>
        <span>Lubumbashi, RDC</span>
      </p>
      <h1
        id="hero-title"
        class="mt-6 text-5xl leading-[0.95] font-bold tracking-[-0.03em] text-balance text-neutral-50 sm:text-6xl xl:text-7xl">
        Des besoins concrets, des produits web fiables.
      </h1>
      <p class="mt-7 max-w-[60ch] text-lg leading-relaxed text-neutral-400">
        J'aide les équipes et les organisations à passer d'un processus flou à une application déployée et maintenable,
        en alliant réflexion produit, développement Angular et NestJS et exploitation en production.
      </p>
      <p class="mt-4 flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-neutral-500">
        <span>Français et anglais</span>
        <span class="size-1 rounded-full bg-neutral-600" aria-hidden="true"></span>
        <span>Ouvert aux postes à temps plein et aux missions freelance</span>
      </p>
      <div class="mt-9 flex flex-wrap items-center gap-3">
        <a class="button-primary" href="#contact">Me contacter</a>
        <a class="button-secondary group" href="/articles">
          Lire les articles
          <Icon class="size-4 transition-transform duration-200 group-hover:translate-x-0.5" name="arrow-right" />
        </a>
      </div>
      <dl class="mt-14 grid grid-cols-3 gap-4 border-t border-neutral-800 pt-8 sm:gap-8">
        {
          stats.map((stat) => (
            <div class="flex flex-col-reverse justify-end gap-2">
              <dt class="text-sm leading-snug text-neutral-400">{stat.label}</dt>
              <dd class="font-code text-xl whitespace-nowrap text-neutral-50 sm:text-2xl md:text-3xl">{stat.value}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </div>

  <div class="relative overflow-hidden lg:absolute lg:inset-y-0 lg:right-0 lg:w-1/2">
    <Image
      class="portrait-reveal aspect-[4/5] max-h-[36rem] w-full object-cover object-[50%_20%] lg:aspect-auto lg:h-full lg:max-h-none"
      src={portrait}
      widths={[480, 853]}
      sizes="(min-width: 64rem) 50vw, 100vw"
      loading="eager"
      fetchpriority="high"
      alt="Portrait de Wilfried Musanzi" />
    <div class="pointer-events-none absolute inset-x-0 top-0 h-24 bg-linear-to-b from-surface to-transparent lg:hidden">
    </div>
    <div class="pointer-events-none absolute inset-x-0 bottom-0 h-32 bg-linear-to-t from-surface to-transparent lg:hidden">
    </div>
    <div
      class="pointer-events-none absolute inset-0 hidden bg-linear-to-r from-surface via-surface/30 to-transparent lg:block">
    </div>
  </div>
</section>
