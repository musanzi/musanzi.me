---
import { Image } from 'astro:assets'
import portrait from '../../assets/wilfried.jpeg'
import Icon from '../shared/Icon.astro'

const stats = [
  { value: '3+', label: "ans d'expérience" },
  { value: '10 000+', label: 'comptes utilisateurs' },
  { value: '13', label: 'apprenants formés' }
]
---

<section class="relative overflow-hidden border-b border-neutral-800" aria-labelledby="hero-title">
  <div class="page-shell relative z-10 flex flex-col justify-center pt-10 pb-10 md:pt-14 md:pb-12 lg:min-h-[min(calc(100svh-4rem),42rem)] lg:py-14">
    <div class="lg:w-[54%] lg:pr-8">
      <h1
        id="hero-title"
        class="text-[min(2.25rem,8.6vw)] leading-[1.02] font-bold tracking-[-0.03em] whitespace-nowrap text-neutral-50 sm:text-5xl md:text-[3.375rem] lg:text-[3rem] xl:text-[3.375rem]">
        Des besoins concrets,<br /> des produits<br /> web fiables.
      </h1>
      <p class="mt-6 max-w-[58ch] text-lg leading-relaxed text-neutral-400">
        Développeur fullstack à Lubumbashi, en RDC, j'aide les équipes et les organisations à passer d'un processus flou
        à une application déployée et maintenable, avec Angular, NestJS et une exploitation en production soignée.
      </p>
      <p class="mt-3 text-sm text-neutral-500">Français et anglais. Ouvert aux postes à temps plein et aux missions freelance.</p>
      <div class="mt-7 flex flex-wrap items-center gap-3">
        <a class="button-primary" href="#contact">Me contacter</a>
        <a class="button-secondary group" href="/articles">
          Lire les articles
          <Icon class="size-4 transition-transform duration-200 group-hover:translate-x-0.5" name="arrow-right" />
        </a>
      </div>
      <dl class="mt-10 flex flex-wrap gap-x-10 gap-y-5 border-t border-neutral-800 pt-7">
        {
          stats.map((stat) => (
            <div class="flex flex-col-reverse gap-1">
              <dt class="text-sm whitespace-nowrap text-neutral-400">{stat.label}</dt>
              <dd class="text-3xl font-semibold tracking-[-0.02em] whitespace-nowrap text-neutral-50 tabular-nums">{stat.value}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </div>

  <div class="relative overflow-hidden lg:absolute lg:inset-y-0 lg:right-0 lg:w-1/2">
    <Image
      class="portrait-reveal aspect-[4/5] max-h-[36rem] w-full object-cover object-[50%_20%] lg:aspect-auto lg:h-full lg:max-h-none"
      src={portrait}
      widths={[480, 853]}
      sizes="(min-width: 64rem) 50vw, 100vw"
      loading="eager"
      fetchpriority="high"
      alt="Portrait de Wilfried Musanzi" />
    <div class="pointer-events-none absolute inset-x-0 top-0 h-24 bg-linear-to-b from-surface to-transparent lg:hidden">
    </div>
    <div class="pointer-events-none absolute inset-x-0 bottom-0 h-32 bg-linear-to-t from-surface to-transparent lg:hidden">
    </div>
    <div
      class="pointer-events-none absolute inset-0 hidden bg-linear-to-r from-surface via-surface/30 to-transparent lg:block">
    </div>
  </div>
</section>
