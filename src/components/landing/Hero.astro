---
import { Image } from 'astro:assets'
import portrait from '../../assets/wilfried.jpeg'
import Icon from '../shared/Icon.astro'

const stats = [
  { value: '3+', label: "ans d'expérience" },
  { value: '10 000+', label: 'comptes utilisateurs' },
  { value: '13', label: 'apprenants formés' }
]
---

<section class="relative overflow-hidden border-b border-neutral-800" aria-labelledby="hero-title">
  <div class="page-shell relative z-10 flex min-h-[calc(100svh-4rem)] flex-col justify-end pt-[38svh] pb-10 md:pb-12 lg:min-h-[min(calc(100svh-4rem),42rem)] lg:py-14">
    <div class="lg:w-[54%] lg:pr-8">
      <p class="mb-5 flex items-center gap-2 font-code text-xs whitespace-nowrap text-primary-400 sm:gap-2.5 sm:text-sm">
        <span class="size-1.5 rounded-full bg-primary-500" aria-hidden="true"></span>
        Développeur web fullstack<span class="hidden min-[360px]:inline">· Angular &amp; NestJS</span>
      </p>
      <h1
        id="hero-title"
        class="text-[min(2.25rem,8.6vw)] leading-[1.02] font-bold tracking-[-0.03em] whitespace-nowrap text-neutral-50 sm:text-5xl md:text-[3.375rem] lg:text-[3rem] xl:text-[3.375rem]">
        Des applications web<br /> livrées, fiables<br /> et <span class="text-primary-400">utilisées.</span>
      </h1>
      <p class="mt-6 max-w-[58ch] text-lg leading-relaxed text-neutral-400">
        Un processus à digitaliser, une plateforme à lancer&nbsp;? Je transforme vos besoins en une application claire,
        mise en production et simple à faire évoluer. Le PNUD, CINOLU et le Katanga Business Meeting m'ont déjà fait
        confiance.
      </p>
      <div class="mt-8 flex flex-wrap items-center gap-3">
        <a class="button-primary" href="#contact">Parlons de votre projet</a>
        <a class="button-secondary group" href="#a-propos">
          Voir mes réalisations
          <Icon class="size-4 transition-transform duration-200 group-hover:translate-x-0.5" name="arrow-right" />
        </a>
      </div>
      <dl class="mt-10 grid grid-cols-3 overflow-hidden rounded-xl border border-neutral-800 bg-neutral-900/40">
        {
          stats.map((stat, index) => (
            <div
              class:list={[
                'flex min-w-0 flex-col-reverse justify-end gap-1 px-3 py-4 sm:px-5 sm:py-5',
                index > 0 && 'border-l border-neutral-800'
              ]}>
              <dt class="text-xs leading-snug text-balance text-neutral-400 sm:text-sm">{stat.label}</dt>
              <dd class="text-xl font-semibold tracking-[-0.02em] whitespace-nowrap text-neutral-50 tabular-nums sm:text-2xl xl:text-3xl">
                {stat.value}
              </dd>
            </div>
          ))
        }
      </dl>
    </div>
  </div>

  <div class="absolute inset-0 overflow-hidden lg:inset-y-0 lg:right-0 lg:left-auto lg:w-1/2">
    <Image
      class="portrait-reveal h-full w-full object-cover object-[60%_10%] opacity-90 sm:object-[50%_10%] lg:object-[50%_20%] lg:opacity-100"
      src={portrait}
      widths={[480, 853]}
      sizes="(min-width: 64rem) 50vw, 100vw"
      loading="eager"
      fetchpriority="high"
      alt="Portrait de Wilfried Musanzi" />
    <div class="pointer-events-none absolute inset-0 bg-linear-to-t from-surface from-40% via-surface/80 via-62% to-surface/0 lg:hidden"></div>
    <div class="pointer-events-none absolute inset-x-0 top-0 h-24 bg-linear-to-b from-surface/80 to-transparent lg:hidden"></div>
    <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_at_50%_25%,transparent_35%,var(--color-surface)_95%)] lg:hidden"></div>
    <div
      class="pointer-events-none absolute inset-0 hidden bg-linear-to-r from-surface via-surface/30 to-transparent lg:block">
    </div>
  </div>
</section>
