---
const steps = [
  {
    verb: 'Comprendre',
    text: 'Je clarifie le vrai problème, j’observe comment l’équipe travaille et je traduis les attentes en exigences produit nettes.',
    tags: ['Entretiens', 'Parcours métier', 'Exigences']
  },
  {
    verb: 'Construire',
    text: 'Interfaces, API, données et outils d’administration, livrés par petites étapes et déployés de façon fiable.',
    tags: ['Angular', 'NestJS', 'TypeScript', 'Docker', 'CI/CD']
  },
  {
    verb: 'Transmettre',
    text: 'Je documente, je forme et je partage mes méthodes, pour que l’équipe garde la main après la livraison.',
    tags: ['Cours', 'Articles', 'Conférences']
  }
]
---

<section class="border-b border-neutral-800" aria-labelledby="value-title">
  <div class="page-shell py-14 md:py-20">
    <h2
      id="value-title"
      class="max-w-[22ch] text-3xl leading-[1.1] font-bold tracking-[-0.03em] text-balance text-neutral-50 md:text-4xl">
      Du besoin à la production, puis au partage.
    </h2>

    <ol
      class="relative mt-10 grid gap-10 before:absolute before:top-3 before:bottom-3 before:left-[0.6875rem] before:w-px before:bg-linear-to-b before:from-primary-600 before:via-neutral-700 before:to-neutral-800 md:mt-14 md:grid-cols-3 md:gap-10 md:before:top-[0.6875rem] md:before:right-0 md:before:bottom-auto md:before:left-0 md:before:h-px md:before:w-auto md:before:bg-linear-to-r">
      {
        steps.map((step, index) => (
          <li class="group relative pl-11 md:pt-12 md:pl-0">
            <span
              class:list={[
                'absolute top-0 left-0 grid size-[1.375rem] place-items-center rounded-full border bg-surface transition-colors duration-300',
                index === 0 ? 'border-primary-500' : 'border-neutral-600 group-hover:border-primary-500'
              ]}
              aria-hidden="true">
              <span
                class:list={[
                  'size-2 rounded-full transition-colors duration-300',
                  index === 0 ? 'bg-primary-500' : 'bg-neutral-600 group-hover:bg-primary-500'
                ]}>
              </span>
            </span>
            <p class="text-sm text-neutral-500">Étape {index + 1}</p>
            <h3 class="mt-1 text-3xl font-bold tracking-[-0.03em] text-neutral-50 md:text-4xl">{step.verb}</h3>
            <p class="mt-3 max-w-[42ch] leading-relaxed text-neutral-400">{step.text}</p>
            <ul class="mt-5 flex flex-wrap gap-2" aria-label={`${step.verb} : repères`}>
              {step.tags.map((tag) => (
                <li class="rounded-full border border-neutral-800 px-3 py-1 text-sm text-neutral-300">{tag}</li>
              ))}
            </ul>
          </li>
        ))
      }
    </ol>
  </div>
</section>
