---
const values = [
  {
    verb: 'Comprendre',
    text: 'Je clarifie le vrai problème, j’observe comment l’équipe travaille et je traduis les attentes en exigences produit nettes.'
  },
  {
    verb: 'Construire',
    text: 'Interfaces, API, données et outils d’administration en Angular, NestJS et TypeScript, déployés avec Docker et la CI/CD.'
  },
  {
    verb: 'Transmettre',
    text: 'Je partage mes méthodes dans des cours, des articles et bientôt des conférences, tous open source.'
  }
]
---

<section class="border-b border-neutral-800" aria-labelledby="value-title">
  <div class="page-shell py-14 md:py-20">
    <h2 id="value-title" class="sr-only">Ce que j’apporte</h2>
    <ol class="border-t border-neutral-800">
      {
        values.map((value) => (
          <li class="group grid gap-3 border-b border-neutral-800 py-7 md:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] md:items-center md:gap-16 md:py-9">
            <h3 class="text-5xl leading-none font-bold tracking-[-0.035em] text-neutral-50 transition-colors duration-300 group-hover:text-primary-400 md:text-6xl lg:text-7xl">
              {value.verb}
            </h3>
            <p class="max-w-[52ch] text-lg leading-relaxed text-neutral-400">{value.text}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>
