---
const steps = [
  {
    title: 'Comprendre le besoin réel',
    text: "Clarifier le vrai problème opérationnel, cartographier la façon dont les équipes travaillent et traduire les attentes des parties prenantes en exigences produit ciblées."
  },
  {
    title: 'Développement fullstack',
    text: "Construire des interfaces, des API, des modèles de données et des outils d'administration maintenables avec Angular, NestJS et TypeScript, puis les déployer de façon fiable avec Docker et la CI/CD."
  },
  {
    title: 'Transmission',
    text: "Partager ce que j'apprends à travers des cours, des articles et des conférences, tous open source."
  }
]
---

<section class="border-b border-neutral-800" aria-labelledby="value-title">
  <div class="page-shell py-20 md:py-28">
    <h2
      id="value-title"
      class="max-w-[22ch] text-4xl leading-[1.05] font-bold tracking-[-0.03em] text-balance text-neutral-50 md:text-5xl">
      Un accompagnement sur tout le cycle de vie du produit.
    </h2>
    <ol class="mt-14 grid gap-10 md:mt-16 md:grid-cols-3 md:gap-8 lg:gap-12">
      {
        steps.map((step, index) => (
          <li class="border-t border-neutral-800 pt-6">
            <span class="font-code text-sm text-primary-500" aria-hidden="true">
              {String(index + 1).padStart(2, '0')}
            </span>
            <h3 class="mt-4 text-xl leading-snug font-semibold text-neutral-50">{step.title}</h3>
            <p class="mt-3 text-lg leading-relaxed text-neutral-400">{step.text}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>
