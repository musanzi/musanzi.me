---
import { getCollection } from 'astro:content'
import Icon from '../shared/Icon.astro'

const courses = (await getCollection('courses')).toSorted(
  (a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime()
)
const chapters = await getCollection('chapters')

function chapterLabel(courseId: string) {
  const count = chapters.filter((chapter) => chapter.data.course.id === courseId).length
  return `${count} ${count > 1 ? 'chapitres' : 'chapitre'}`
}
---

{
  courses.length > 0 && (
    <section id="cours" class="scroll-mt-20 border-b border-neutral-800" aria-labelledby="cours-title">
      <div class="page-shell py-20 md:py-28">
        <div class="flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
          <h2
            id="cours-title"
            class="max-w-[22ch] text-4xl leading-[1.05] font-bold tracking-[-0.03em] text-balance text-neutral-50 md:text-5xl">
            Des cours ouverts, pour apprendre en construisant.
          </h2>
          <a class="text-link group inline-flex shrink-0 items-center gap-2" href="/cours">
            Tous les cours
            <Icon class="size-4 transition-transform duration-200 group-hover:translate-x-0.5" name="arrow-right" />
          </a>
        </div>
        <ul class="mt-12 border-t border-neutral-800 md:mt-16">
          {courses.map((course) => (
            <li class="border-b border-neutral-800">
              <a
                class="group grid gap-3 py-8 md:grid-cols-[1fr_auto] md:items-baseline md:gap-8"
                href={`/cours/${course.id}`}>
                <div>
                  <h3 class="text-xl leading-snug font-semibold text-balance text-neutral-50 transition-colors group-hover:text-primary-300 md:text-2xl">
                    {course.data.title}
                  </h3>
                  <p class="mt-2 max-w-[70ch] leading-relaxed text-neutral-400">{course.data.description}</p>
                </div>
                <span class="flex items-center gap-3 font-code text-sm whitespace-nowrap text-neutral-500">
                  {chapterLabel(course.id)}
                  <Icon
                    class="size-4 text-neutral-400 transition-transform duration-200 group-hover:translate-x-1 group-hover:text-primary-300"
                    name="arrow-right"
                  />
                </span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )
}
