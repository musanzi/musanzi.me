---
import { getCollection } from 'astro:content'
import CourseRow from '../courses/CourseRow.astro'
import Icon from '../shared/Icon.astro'
import { getCourseChapters, getTotalReadingMinutes, sortCourses } from '../../lib/courses'

const courses = await Promise.all(
  sortCourses(await getCollection('courses')).map(async (course) => {
    const chapters = await getCourseChapters(course.id)
    return { course, chapterCount: chapters.length, totalMinutes: getTotalReadingMinutes(chapters) }
  })
)
---

{
  courses.length > 0 && (
    <section id="cours" class="scroll-mt-32 md:scroll-mt-20 border-b border-neutral-800" aria-labelledby="cours-title">
      <div class="page-shell py-14 md:py-20">
        <div class="flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
          <h2
            id="cours-title"
            class="max-w-[22ch] text-3xl leading-[1.1] font-bold tracking-[-0.03em] text-balance text-neutral-50 md:text-4xl">
            Des cours ouverts, pour apprendre en construisant.
          </h2>
          <a class="text-link group inline-flex shrink-0 items-center gap-2" href="/cours">
            Tous les cours
            <Icon class="size-4 transition-transform duration-200 group-hover:translate-x-0.5" name="arrow-right" />
          </a>
        </div>
        <ul class="mt-8 border-t border-neutral-800 md:mt-10">
          {courses.map((entry) => (
            <CourseRow
              course={entry.course}
              chapterCount={entry.chapterCount}
              totalMinutes={entry.totalMinutes}
              headingLevel={3}
            />
          ))}
        </ul>
      </div>
    </section>
  )
}
