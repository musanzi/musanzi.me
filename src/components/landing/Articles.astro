---
import { getCollection } from 'astro:content'
import ArticleRow from '../articles/ArticleRow.astro'
import Icon from '../shared/Icon.astro'
import { sortArticles } from '../../lib/articles'

const articles = sortArticles(await getCollection('articles')).slice(0, 3)
---

<section id="articles" class="scroll-mt-32 md:scroll-mt-20 border-b border-neutral-800" aria-labelledby="articles-title">
  <div class="page-shell py-14 md:py-20">
    <div class="flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
      <h2
        id="articles-title"
        class="max-w-[22ch] text-3xl leading-[1.1] font-bold tracking-[-0.03em] text-balance text-neutral-50 md:text-4xl">
        Notes sur le logiciel et le travail qui l'entoure.
      </h2>
      <a class="text-link group inline-flex shrink-0 items-center gap-2" href="/articles">
        Tous les articles
        <Icon class="size-4 transition-transform duration-200 group-hover:translate-x-0.5" name="arrow-right" />
      </a>
    </div>
    <ul class="mt-8 border-t border-neutral-800 md:mt-10">
      {articles.map((article) => <ArticleRow post={article} headingLevel={3} />)}
    </ul>
  </div>
</section>
