---
import Icon from '../shared/Icon.astro'
import { formatArticleDate, getReadingTime, type Article } from '../../lib/articles'

interface Props {
  post: Article
  headingLevel: 2 | 3
}

const { post, headingLevel } = Astro.props
const Heading = headingLevel === 2 ? 'h2' : 'h3'
---

<li class="border-b border-neutral-800">
  <a class="group grid gap-3 py-8 md:grid-cols-[10rem_1fr_auto] md:items-baseline md:gap-8" href={`/articles/${post.id}`}>
    <time class="font-code text-sm text-neutral-500" datetime={post.data.publishedAt.toISOString()}>
      {formatArticleDate(post.data.publishedAt)}
    </time>
    <div>
      <Heading
        class="text-xl leading-snug font-semibold text-balance text-neutral-50 transition-colors group-hover:text-primary-300 md:text-2xl">
        {post.data.title}
      </Heading>
      <p class="mt-2 max-w-[70ch] leading-relaxed text-neutral-400">{post.data.description}</p>
    </div>
    <span class="flex items-center gap-3 font-code text-sm whitespace-nowrap text-neutral-500">
      {getReadingTime(post.body)}
      <Icon
        class="size-4 text-neutral-400 transition-transform duration-200 group-hover:translate-x-1 group-hover:text-primary-300"
        name="arrow-right"
      />
    </span>
  </a>
</li>
