---
import Thumbnail from '../shared/Thumbnail.astro'
import { formatArticleDate, getReadingTime, type Article } from '../../lib/articles'

interface Props {
  post: Article
  headingLevel: 2 | 3
}

const { post, headingLevel } = Astro.props
const Heading = headingLevel === 2 ? 'h2' : 'h3'
---

<li class="border-b border-neutral-800">
  <a
    class="group grid gap-4 py-6 sm:grid-cols-[13rem_1fr] sm:items-center sm:gap-6 md:grid-cols-[16rem_1fr] md:gap-8"
    href={`/articles/${post.id}`}>
    <Thumbnail
      class="transition-colors duration-200 group-hover:border-neutral-600"
      title={post.data.cover?.title ?? post.data.title}
      subtitle={post.data.cover?.subtitle}
      sizes="(min-width: 40rem) 8rem, 46vw" />
    <div>
      <p class="flex flex-wrap items-center gap-x-2.5 font-code text-sm text-neutral-500">
        <time datetime={post.data.publishedAt.toISOString()}>{formatArticleDate(post.data.publishedAt)}</time>
        <span class="size-1 rounded-full bg-neutral-600" aria-hidden="true"></span>
        <span>{getReadingTime(post.body)}</span>
      </p>
      <Heading
        class="mt-2 text-xl leading-snug font-semibold text-balance text-neutral-50 transition-colors group-hover:text-primary-300 md:text-2xl">
        {post.data.title}
      </Heading>
      <p class="mt-2 max-w-[65ch] leading-relaxed text-neutral-400">{post.data.description}</p>
    </div>
  </a>
</li>
