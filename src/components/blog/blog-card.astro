---
import Icon from '../shared/icon.astro'
import { formatPostDate, getReadingTime, type BlogPost } from '../../lib/blog'

interface Props {
  post: BlogPost
}

const { post } = Astro.props
---

<a
  class="group flex h-full flex-col rounded-xl border border-neutral-800 bg-neutral-900/50 p-5 transition duration-200 hover:-translate-y-0.5 hover:border-primary-600/70 hover:bg-neutral-900 focus-visible:ring-2 focus-visible:ring-primary-400 focus-visible:outline-none"
  href={`/blog/${post.id}`}
  aria-label={`Read ${post.data.title}`}>
  <div class="flex flex-wrap items-center gap-x-2 gap-y-1 text-sm text-neutral-500">
    <time datetime={post.data.publishedAt.toISOString()}>{formatPostDate(post.data.publishedAt)}</time>
    <span aria-hidden="true">&middot;</span>
    <span>{getReadingTime(post.body)}</span>
  </div>

  <h3 class="mt-3 text-xl leading-snug font-semibold text-neutral-100 transition group-hover:text-primary-300">
    {post.data.title}
  </h3>
  <p class="mt-3 flex-1 leading-relaxed text-neutral-400">{post.data.description}</p>

  <ul class="mt-4 flex flex-wrap gap-2" aria-label="Topics">
    {post.data.tags.map((tag) => (
      <li class="rounded-full border border-neutral-700 px-2.5 py-1 text-xs font-medium text-neutral-400">{tag}</li>
    ))}
  </ul>

  <span class="mt-5 inline-flex w-fit items-center gap-1.5 text-sm font-semibold text-primary-400 transition group-hover:text-primary-300">
    Read article
    <Icon class="size-3.5 transition-transform group-hover:translate-x-1" name="arrow-right" />
  </span>
</a>
