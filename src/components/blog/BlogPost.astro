---
import { render } from 'astro:content'
import type { BlogPost } from '../../lib/blog'
import { formatPostDate, getReadingTime } from '../../lib/blog'

interface Props {
  post: BlogPost
}

const { post } = Astro.props
const { Content } = await render(post)
---

<article class="pt-8 text-neutral-300 md:pt-12">
  <a class="inline-flex items-center gap-2 text-sm font-medium text-neutral-400 transition hover:text-primary-400 focus-visible:rounded-sm focus-visible:ring-2 focus-visible:ring-primary-400 focus-visible:outline-none" href="/blog">
    <span aria-hidden="true">&larr;</span>
    Back to all posts
  </a>

  <header class="mt-10 border-b border-neutral-800 pb-9 md:pb-12">
    <time class="text-primary-500" datetime={post.data.publishedAt.toISOString()}>{formatPostDate(post.data.publishedAt)}</time>
    <h1 class="mt-2 max-w-4xl text-4xl leading-tight font-bold tracking-tight text-neutral-50 md:text-6xl">{post.data.title}</h1>
    <p class="mt-6 max-w-3xl text-lg leading-7 text-neutral-400 md:text-xl">{post.data.description}</p>
    <div class="mt-6 flex flex-wrap items-center gap-x-2 gap-y-1 text-sm text-neutral-500">
      <span>{post.data.author}</span>
      <span aria-hidden="true">&middot;</span>
      <span>{getReadingTime(post.body)}</span>
    </div>
    <ul class="mt-4 flex flex-wrap gap-2" aria-label="Topics">
      {post.data.tags.map((tag) => <li class="rounded-full border border-neutral-700 px-2.5 py-1 text-xs font-medium text-neutral-400">{tag}</li>)}
    </ul>
  </header>

  <div class="blog-prose mx-auto mt-10 md:mt-14">
    <Content />
  </div>

  <footer class="mt-14 flex gap-4 border-t border-neutral-800 pt-8 items-center justify-between">
    <a class="inline-flex items-center gap-2 text-sm font-semibold text-neutral-300 transition hover:text-primary-400 focus-visible:rounded-sm focus-visible:ring-2 focus-visible:ring-primary-400 focus-visible:outline-none" href="/blog">
      <span aria-hidden="true">&larr;</span>
      Back to all posts
    </a>
    <a class="inline-flex items-center gap-2 text-sm font-semibold text-primary-400 transition hover:text-primary-300 focus-visible:rounded-sm focus-visible:ring-2 focus-visible:ring-primary-400 focus-visible:outline-none" href="/#contact">
      Let's work together
      <span aria-hidden="true">&rarr;</span>
    </a>
  </footer>
</article>
