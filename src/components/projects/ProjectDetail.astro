---
import { render } from 'astro:content'
import Icon from '../shared/Icon.astro'
import type { Project } from '../../lib/projects'

interface Props {
  project: Project
}

const { project } = Astro.props
const { Content } = await render(project)
---

<article class="pt-8 text-neutral-300 md:pt-12">
  <a
    class="mb-10 inline-flex items-center gap-2 text-sm font-medium text-neutral-400 transition hover:text-primary-400 focus-visible:rounded-sm focus-visible:ring-2 focus-visible:ring-primary-400 focus-visible:outline-none"
    href="/projects">
    <span aria-hidden="true">&larr;</span>
    Back to projects
  </a>

  <header class="mb-8 md:mb-10">
    <div class="mb-4 flex flex-wrap items-center gap-x-2 gap-y-1 text-sm font-medium text-primary-400">
      <span>{project.data.role}</span>
      <span aria-hidden="true">&middot;</span>
      <span>{project.data.organization}</span>
      {project.data.period && (
        <>
          <span aria-hidden="true">&middot;</span>
          <span>{project.data.period}</span>
        </>
      )}
    </div>
    <h1 class="max-w-3xl text-4xl leading-tight font-bold tracking-tight text-neutral-50 md:text-6xl">
      {project.data.title}
    </h1>
    <p class="mt-5 max-w-3xl text-lg leading-relaxed text-neutral-400 md:text-xl">
      {project.data.summary}
    </p>
    {project.data.links.length > 0 && (
      <div class="mt-7 flex flex-wrap gap-3" aria-label="Project links">
        {project.data.links.map((link) => (
          <a
            class:list={[
              'inline-flex items-center gap-2 rounded-lg px-4 py-2 text-sm font-semibold transition focus-visible:ring-2 focus-visible:ring-primary-400 focus-visible:outline-none',
              link.type === 'live'
                ? 'bg-primary-500 text-white hover:bg-primary-400'
                : 'border border-neutral-700 bg-neutral-900 text-neutral-200 hover:border-primary-700 hover:text-primary-400',
            ]}
            href={link.url}
            target="_blank"
            rel="noreferrer">
            <Icon class="size-4" name={link.type === 'github' ? 'github' : 'arrow-up-right'} />
            {link.label}
          </a>
        ))}
      </div>
    )}
  </header>

  <figure class="mb-14 h-64 overflow-hidden rounded-md border border-neutral-700 bg-neutral-950 shadow-2xl shadow-black/20 sm:h-80 md:mb-18 md:h-112">
    <img
      class="size-full object-cover"
      src={project.data.image.src}
      alt={project.data.imageAlt}
      width={project.data.image.width}
      height={project.data.image.height}
      loading="eager"
      decoding="async"
      fetchpriority="high"
    />
  </figure>

  {project.data.outcomes.length > 0 && (
    <section class="mb-14 border-b border-neutral-800 py-8 md:mb-18 md:py-10" aria-labelledby="project-outcomes-title">
      <div class="mb-6 flex items-center gap-3">
        <h2 id="project-outcomes-title" class="shrink-0 text-sm font-semibold tracking-wide text-neutral-300 uppercase">
          Selected outcomes
        </h2>
        <div class="h-px w-full bg-neutral-800" aria-hidden="true"></div>
      </div>

      <ol class="grid gap-x-10 gap-y-6 sm:grid-cols-2">
        {project.data.outcomes.map((outcome, index) => (
          <li class="grid grid-cols-[2rem_1fr] gap-3">
            <span class="font-mono text-sm font-semibold text-primary-500" aria-hidden="true">
              {String(index + 1).padStart(2, '0')}
            </span>
            <span class="leading-relaxed text-neutral-300">{outcome}</span>
          </li>
        ))}
      </ol>
    </section>
  )}

  <div class="blog-prose">
    <Content />
  </div>

  <footer class="mt-14 flex justify-between gap-4 border-t border-neutral-800 pt-8 items-center">
    <a
      class="inline-flex items-center gap-2 text-sm font-semibold text-primary-400 transition hover:text-primary-300 focus-visible:rounded-sm focus-visible:ring-2 focus-visible:ring-primary-400 focus-visible:outline-none"
      href="/projects">
      <span aria-hidden="true">&larr;</span>
      More projects
    </a>
    <a class="inline-flex items-center gap-2 text-sm font-semibold text-neutral-300 transition hover:text-primary-400 focus-visible:rounded-sm focus-visible:ring-2 focus-visible:ring-primary-400 focus-visible:outline-none" href="/#contact">
      Let's work
      <span aria-hidden="true">&rarr;</span>
    </a>
  </footer>
</article>
