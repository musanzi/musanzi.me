---
import Icon from '../shared/Icon.astro'
import type { IProject } from '../../data/projects'

interface Props {
  project: IProject
}

const { project } = Astro.props
---

<a
  class="group flex h-full flex-col overflow-hidden rounded-xl border border-neutral-800 bg-neutral-900/50 transition duration-200 hover:-translate-y-0.5 hover:border-primary-600/70 hover:bg-neutral-900 focus-visible:ring-2 focus-visible:ring-primary-400 focus-visible:outline-none"
  href={`/projects/${project.slug}`}
  aria-label={`View ${project.name} case study`}>
  <div class="h-52 overflow-hidden border-b border-neutral-800 bg-neutral-950 sm:h-56">
    <img
      class="size-full object-cover transition duration-300 group-hover:scale-[1.02]"
      src={project.image.src}
      alt={project.imageAlt}
      width={project.image.width}
      height={project.image.height}
      loading="lazy"
      decoding="async"
    />
  </div>
  <div class="flex flex-1 flex-col p-5">
    <h3 class="text-lg leading-snug font-semibold text-neutral-100">{project.name}</h3>
    <p class="mt-3 flex-1 leading-relaxed text-neutral-400">{project.summary}</p>

    <span class="mt-4 inline-flex w-fit items-center gap-1.5 text-sm font-semibold text-primary-400 transition group-hover:text-primary-300">
      View case study
      <Icon class="size-3.5 transition-transform group-hover:translate-x-1" name="arrow-right" />
    </span>
  </div>
</a>
