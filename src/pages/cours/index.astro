---
import { getCollection } from 'astro:content'
import CourseRow from '../../components/courses/CourseRow.astro'
import Layout from '../../layouts/Layout.astro'
import { getCourseChapters, getTotalReadingMinutes, sortCourses } from '../../lib/courses'

const courses = await Promise.all(
  sortCourses(await getCollection('courses')).map(async (course) => {
    const chapters = await getCourseChapters(course.id)
    return { course, chapterCount: chapters.length, totalMinutes: getTotalReadingMinutes(chapters) }
  })
)
---

<Layout
  title="Cours | Wilfried Musanzi"
  description="Des cours gratuits et open source sur le développement web et les outils d'IA, tirés de la pratique quotidienne d'un développeur fullstack.">
  <div class="page-shell py-16 md:py-24">
    <header class="max-w-3xl">
      <h1 class="text-5xl leading-[1.05] font-bold tracking-[-0.03em] text-balance text-neutral-50 md:text-7xl">Cours</h1>
      <p class="mt-6 text-lg leading-relaxed text-pretty text-neutral-400 md:text-xl">
        Des cours gratuits et open source, tirés de mon travail quotidien de développeur. Chaque cours est publié sous
        licence CC&nbsp;BY&nbsp;4.0&nbsp;: vous pouvez le lire, le partager et l'adapter.
      </p>
    </header>

    {
      courses.length > 0 ? (
        <ul class="mt-14 border-t border-neutral-800 md:mt-20">
          {courses.map((entry) => (
            <CourseRow course={entry.course} chapterCount={entry.chapterCount} totalMinutes={entry.totalMinutes} />
          ))}
        </ul>
      ) : (
        <p class="mt-14 border-t border-neutral-800 pt-8 text-neutral-400 md:mt-20">Le premier cours arrive bientôt.</p>
      )
    }
  </div>
</Layout>
