---
import { getCollection } from 'astro:content'
import BlogCard from '../../components/blog/blog-card.astro'
import Layout from '../../layouts/Layout.astro'
import { sortPosts } from '../../lib/blog'

const posts = sortPosts(await getCollection('blog'))
---

<Layout title="Blog | Wilfried Musanzi" description="Practical writing about NestJS, web development, AI, and building reliable software.">
  <main class="pt-8 md:pt-12">
    <a class="inline-flex items-center gap-2 text-sm font-medium text-neutral-400 transition hover:text-primary-400 focus-visible:rounded-sm focus-visible:ring-2 focus-visible:ring-primary-400 focus-visible:outline-none" href="/">
      <span aria-hidden="true">&larr;</span>
      Back home
    </a>
    <header class="mt-10 mb-10 md:mb-12">
      <h1 class="mt-3 text-4xl leading-tight font-bold tracking-tight text-neutral-50 md:text-6xl">Writing</h1>
      <p class="mt-5 max-w-2xl text-lg leading-relaxed text-neutral-400">
        Practical notes on software engineering, the tools changing our work, and the judgment required to use them well.
      </p>
    </header>
    <div class="grid gap-4 md:grid-cols-2">
      {posts.map((post) => <BlogCard post={post} />)}
    </div>
  </main>
</Layout>
