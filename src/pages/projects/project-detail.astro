---
import Icon from '../../components/shared/icon.astro'

interface Props {
  name: string
  summary: string
  problem: string
  solution: string
  responsibilities: string[]
  technologies: string[]
  highlights: string[]
}

const {
  name,
  summary,
  problem,
  solution,
  responsibilities,
  technologies,
  highlights,
} = Astro.props
---

<article class="pt-8 text-neutral-300 md:pt-12">
  <a
    class="mb-9 inline-flex items-center gap-2 text-sm font-medium text-neutral-400 transition hover:text-primary-400 focus-visible:rounded-sm focus-visible:ring-2 focus-visible:ring-primary-400 focus-visible:outline-none"
    href="/#projects">
    <span aria-hidden="true">&larr;</span>
    Back to projects
  </a>

  <header class="mb-12 border-b border-neutral-700 pb-10">
    <h1 class="max-w-3xl text-3xl leading-tight font-bold text-neutral-50 md:text-5xl">{name}</h1>
    <p class="mt-5 max-w-3xl text-lg leading-relaxed text-neutral-400">{summary}</p>
  </header>

  <div class="grid gap-10 md:grid-cols-[minmax(0,1fr)_15rem] md:gap-14">
    <div class="space-y-10">
      <section aria-labelledby="problem-title">
        <h2 id="problem-title" class="mb-3 text-2xl font-bold text-primary-400">The problem</h2>
        <p class="leading-relaxed text-neutral-400">{problem}</p>
      </section>

      <section aria-labelledby="solution-title">
        <h2 id="solution-title" class="mb-3 text-2xl font-bold text-primary-400">The solution</h2>
        <p class="leading-relaxed text-neutral-400">{solution}</p>
      </section>

      <section aria-labelledby="contribution-title">
        <h2 id="contribution-title" class="mb-4 text-2xl font-bold text-primary-400">What I contributed</h2>
        <ul class="grid gap-3 sm:grid-cols-2">
          {responsibilities.map((responsibility) => (
            <li class="flex gap-3 rounded-lg border border-neutral-800 bg-neutral-900/50 p-4 text-sm leading-relaxed text-neutral-300">
              <span class="mt-2 size-1.5 shrink-0 rounded-full bg-primary-500" aria-hidden="true"></span>
              {responsibility}
            </li>
          ))}
        </ul>
      </section>

      <section aria-labelledby="outcomes-title">
        <h2 id="outcomes-title" class="mb-4 text-2xl font-bold text-neutral-50">Highlights and outcomes</h2>
        <ul class="space-y-3">
          {highlights.map((highlight) => (
            <li class="flex gap-3 leading-relaxed text-neutral-400">
              <Icon class="mt-1 size-4 shrink-0 text-primary-400" name="list-checks" />
              {highlight}
            </li>
          ))}
        </ul>
      </section>
    </div>

    <aside class="md:sticky md:top-8 md:self-start" aria-labelledby="stack-title">
      <div class="rounded-xl border border-neutral-700 bg-neutral-900/60 p-5">
        <h2 id="stack-title" class="mb-4 text-sm font-semibold text-neutral-100">Technology stack</h2>
        <ul class="flex flex-wrap gap-2">
          {technologies.map((technology) => (
            <li class="rounded-md bg-neutral-800 px-2.5 py-1.5 text-xs font-medium text-neutral-400">{technology}</li>
          ))}
        </ul>
      </div>
    </aside>
  </div>
</article>
