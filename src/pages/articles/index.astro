---
import { getCollection } from 'astro:content'
import ArticleCard from '../../components/articles/ArticleCard.astro'
import Layout from '../../layouts/Layout.astro'
import { sortArticles } from '../../lib/articles'

const articles = sortArticles(await getCollection('articles'))
---

<Layout title="Articles | Wilfried Musanzi" description="Des articles pratiques sur le développement web, NestJS, l'IA et la construction de logiciels fiables.">
  <main class="pt-8 md:pt-12">
    <a class="inline-flex items-center gap-2 text-sm font-medium text-neutral-400 transition hover:text-primary-400 focus-visible:rounded-sm focus-visible:ring-2 focus-visible:ring-primary-400 focus-visible:outline-none" href="/">
      <span aria-hidden="true">&larr;</span>
      Accueil
    </a>
    <header class="mt-10 mb-10 md:mb-12">
      <h1 class="mt-3 text-4xl leading-tight font-bold tracking-tight text-neutral-50 md:text-6xl">Articles</h1>
      <p class="mt-5 max-w-2xl text-lg leading-relaxed text-neutral-400">
        Des notes pratiques sur le génie logiciel, les outils qui transforment notre métier et le discernement qu'il faut pour bien s'en servir.
      </p>
    </header>
    <div class="grid gap-4 md:grid-cols-2">
      {articles.map((article) => <ArticleCard post={article} />)}
    </div>
  </main>
</Layout>
