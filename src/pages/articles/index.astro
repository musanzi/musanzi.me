---
import { getCollection } from 'astro:content'
import ArticleRow from '../../components/articles/ArticleRow.astro'
import Layout from '../../layouts/Layout.astro'
import { sortArticles } from '../../lib/articles'

const articles = sortArticles(await getCollection('articles'))
---

<Layout
  title="Articles | Wilfried Musanzi"
  description="Des articles pratiques sur le développement web, NestJS, l'IA et la construction de logiciels fiables.">
  <div class="page-shell py-16 md:py-24">
    <header>
      <h1 class="text-5xl leading-[1.05] font-bold tracking-[-0.03em] text-balance text-neutral-50 md:text-7xl">
        Articles
      </h1>
      <p class="mt-6 max-w-[70ch] text-lg leading-relaxed text-neutral-400">
        Des notes pratiques sur le génie logiciel, les outils qui transforment notre métier et le discernement qu'il faut
        pour bien s'en servir.
      </p>
    </header>
    <ul class="mt-12 border-t border-neutral-800 md:mt-16">
      {articles.map((article) => <ArticleRow post={article} headingLevel={2} />)}
    </ul>
  </div>
</Layout>
