---
import { ClientRouter } from "astro:transitions";
import profileImage from "../assets/wilfried.jpeg";
import "../styles/global.css";
import Footer from "./Footer.astro";
import Header from "./Header.astro";

interface Props {
  title?: string;
  description?: string;
  ogType?: "website" | "article";
  publishedTime?: string;
}

const {
  title = "Wilfried Musanzi | Développeur web fullstack",
  description = "Développeur web fullstack : je conçois des produits web fiables avec Angular et NestJS pour les entreprises, les ONG, les programmes d'innovation et les équipes en croissance.",
  ogType = "website",
  publishedTime,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const socialImageURL = new URL(profileImage.src, Astro.site);

const structuredData = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Wilfried Musanzi",
  url: Astro.site,
  image: socialImageURL,
  jobTitle: "Développeur web fullstack",
  worksFor: {
    "@type": "Organization",
    name: "CINOLU",
    url: "https://cinolu.org",
  },
  sameAs: [
    "https://github.com/musanzi",
    "https://www.linkedin.com/in/wilfried-musanzi-197381205",
  ],
};
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Wilfried Musanzi" />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#181715" />
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:site_name" content="Wilfried Musanzi" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={socialImageURL} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content={profileImage.width.toString()} />
    <meta property="og:image:height" content={profileImage.height.toString()} />
    <meta property="og:image:alt" content="Wilfried Musanzi" />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageURL} />
    <meta name="twitter:image:alt" content="Wilfried Musanzi" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Google+Sans:ital,opsz,wght@0,17..18,400..700;1,17..18,400..700&family=Google+Sans+Code:wght@400..600&display=swap" rel="stylesheet">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-4DDVNK8CP4"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-4DDVNK8CP4');
    </script>
    <ClientRouter />
  </head>
  <body class="flex min-h-dvh flex-col">
    <a
      class="sr-only rounded-lg bg-primary-action px-4 py-3 text-sm font-semibold text-white focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50"
      href="#contenu">
      Aller au contenu
    </a>
    <Header />
    <main id="contenu" class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
